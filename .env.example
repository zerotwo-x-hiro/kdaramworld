# KDramaWorld Environment Variables

# PostgreSQL Database Connection (Supabase pooled connection string, e.g. port 6543)
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Test PostgreSQL Database Connection (Used for Vitest integration tests against real Postgres)
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kdramaworld_test

# Database Pool Max Connections (default: 10)
DATABASE_POOL_MAX=10

# Auth Secret (Minimum 32 characters random secret for HMAC token hashing)
AUTH_SECRET=changeme-super-secret-hex-token-min-32-chars-long-12345

# Canonical Public Site URL (e.g. https://kdramaworld.vercel.app or http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin Emails (comma-separated list of emails that automatically receive admin role upon registration)
ADMIN_EMAILS=admin@kdramaworld.local,owner@kdramaworld.local

# TMDB Read Access Token (Server-side only v4 Bearer token for dramas, air dates, cast & crew)
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# OMDb API Key (For IMDb ratings & vote counts sync, free tier ~1000 calls/day)
OMDB_API_KEY=your_omdb_api_key_here

# Cron Secret for Vercel Cron & GitHub Actions Sync Endpoints
CRON_SECRET=changeme-secure-cron-bearer-token-12345
